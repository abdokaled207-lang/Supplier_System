# Roti Chani System — Frontend Environment Variables
# Copy this file to .env in the frontend/ directory and fill in the values.
# Do not commit real secrets — .env is gitignored.

# --- API URL ---
# The base URL of the Roti Chani API.
# In development, this is proxied by Vite to http://localhost:4000/api.
# In production, set this to your deployed backend URL,
# e.g. VITE_API_URL=https://your-backend.up.railway.app/api
# If your frontend and backend are served from the same origin,
# you can leave this unset or set to "/api".
VITE_API_URL=http://localhost:4000/api

# --- Public Base URL ---
# Used for generating absolute links in shared content (e.g. invoice PDFs).
# In development, defaults to the browser's current origin.
# In production, set this to your deployed frontend URL,
# e.g. VITE_PUBLIC_URL=https://your-app.vercel.app
# Leave empty to use window.location.origin at runtime.
# VITE_PUBLIC_URL=https://your-app.vercel.app

# --- Node environment ---
# Optional: set to "production" to enable production-mode builds.
# Vercel sets this automatically when building for production.
NODE_ENV=development

# --- Port ---
# The port the Vite dev server runs on.
# Ignored in production builds.
PORT=5173
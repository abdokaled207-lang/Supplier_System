# Roti Chani System — Backend Environment Variables
# Copy this file to .env in the backend/ directory and fill in the values.
# Do not commit real secrets — .env is gitignored.

# --- Database ---
# The connection string for the MySQL database.
# Railway will provide this when you provision a MySQL instance:
# mysql://username:password@hostname:3306/database_name?sslaccept=STRICT
# For local dev with Docker:
# DATABASE_URL="mysql://app:app_password@localhost:3306/roti_chani_system"
# For local dev with MySQL80 Windows service:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/roti_chani_system"

DATABASE_URL="mysql://app:app_password@localhost:3306/roti_chani_system"

# --- App ---
# Port the API server listens on.
# Railway injects PORT automatically (see backend/railway.toml) — you usually
# don't need to set it here.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# JWT secret used to sign/verify access tokens.
# In production, this MUST be a random string of at least 32 characters.
# The backend will reject weak secrets at startup when NODE_ENV=production.
# Example: JWT_SECRET=super-secret-key-that-is-at-least-32-chars-long!
JWT_SECRET=dev-secret-change-me

# How long a JWT access token remains valid.
# Expressed as a string compatible with the `jwt.SignOptions["expiresIn"]` type.
# e.g. "7d" (7 days), "1h" (1 hour), "24h" (24 hours).
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed browser origins.
# REQUIRED in production (the server refuses to start without it, rather than
# silently accepting every origin). Set it to your Vercel frontend URL:
# CORS_ORIGIN=https://your-app.vercel.app
# In development (NODE_ENV != production) CORS is permissive when unset.
# CORS_ORIGIN=https://your-app.vercel.app

# --- Seed admin user ---
# Email and password for the default admin account used during seeding.
# These are only used when running `npm run db:seed`.
# SEED_ADMIN_EMAIL=admin@roti.local
# SEED_ADMIN_PASSWORD=Admin123!

# --- Invoice PDF storage ---
# Directory where uploaded invoice PDFs are written (served at /files/invoices).
# Defaults to ./storage/invoices relative to the backend working directory.
# REQUIRED ON RAILWAY: the container filesystem is EPHEMERAL (wiped on every
# redeploy). Provision a persistent volume and point this at its mount path,
# e.g. mount the volume at /data/invoices and set:
# INVOICES_DIR=/data/invoices
# INVOICES_DIR=
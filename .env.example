# --- Database ---
# Docker MySQL (docker compose up -d db)
DATABASE_URL="mysql://app:app_password@localhost:3306/roti_chani_system"
# Local MySQL80 Windows service usually has root with a password you set at install.
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/roti_chani_system"

# --- App ---
PORT=4000
NODE_ENV=development
# Use a long random value (>= 32 chars) in production. Known defaults are rejected.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (used in production). Leave empty for permissive CORS in dev.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# --- Seed admin user ---
SEED_ADMIN_EMAIL=admin@roti.local
SEED_ADMIN_PASSWORD=Admin123!

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api
